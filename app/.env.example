# The website (API under /api). On a real phone, localhost is the phone itself: use the computer's LAN IP,
# e.g. http://192.168.1.20:3000. Copy to .env.local.
EXPO_PUBLIC_API_URL=http://localhost:3000

# PostHog project key (same project as the website). Empty = analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google sign-in (Google Cloud → Credentials → OAuth client ids). The web client id is the one the website's
# GOOGLE_CLIENT_ID lists too; without these the Google button is hidden. Needs a development build, not Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat public SDK keys (Project settings → API keys: appl_… for iOS, goog_… for Android). Empty = the
# paywall says subscriptions aren't available. Real purchases need a development build, not Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
