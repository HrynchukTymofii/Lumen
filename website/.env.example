# Postgres connection string used by Prisma
DATABASE_URL="postgresql://lumen:lumen@localhost:5433/lumen?schema=public"

# Admin (/admin): comma-separated emails allowed in, and the secret that signs the admin cookie
ADMIN_EMAILS="you@example.com"
ADMIN_JWT_SECRET="long-random-string"

# Email login codes (without a key, codes are printed in the dev server console)
RESEND_API_KEY=""
EMAIL_FROM="Lumen <hello@example.com>"

# Cloudflare R2 (audio files)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://audio.example.com"

# ElevenLabs (prayer audio)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Claude (prayer generation script)
ANTHROPIC_API_KEY=""

# PostHog (analytics). Project API key from PostHog → Project settings. Empty = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# User sessions (web cookie + app Bearer token). 64+ random characters.
JWT_SECRET="long-random-string-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store pages for the "Get the app" buttons (no web payments: Premium is bought in the stores).
# Optional overrides; defaults are in lib/site.ts (App Store id6829436290, no Google Play yet = button hidden).
# NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/id6829436290"
# NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=com.hrynchuk.biblecompanion"

# App Store Connect API (npm run prices:sync, run on your machine only). Key: App Store Connect → Users and Access →
# Integrations → Team Keys. The .p8 goes in website/secrets/ (gitignored).
ASC_ISSUER_ID=""
ASC_KEY_ID=""
ASC_KEY_PATH="secrets/AuthKey_XXXXXXXXXX.p8"

# RevenueCat (in-app subscriptions). Secret API key (sk_…) from Project settings → API keys, and any long random
# string that you also paste in RevenueCat → Integrations → Webhooks → Authorization header. Webhook URL:
# https://<your site>/api/webhooks/revenuecat
REVENUECAT_SECRET_KEY=""
REVENUECAT_WEBHOOK_AUTH=""

# Sign in with Apple / Google from the phone app (token audience). Google: comma-separated iOS/Android/web client ids.
APPLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
# Sign in with Apple key (developer.apple.com → Keys, "Sign in with Apple"), so deleting an account revokes it at
# Apple (lib/auth/apple.ts). APPLE_PRIVATE_KEY is the .p8 file's contents with newlines written as \n.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# App Store / Google Play review login (lib/auth/review.ts): this email signs in with this fixed 6-digit code,
# and no email is sent. Leave empty to turn it off.
REVIEW_LOGIN_EMAIL=""
REVIEW_LOGIN_CODE=""

# Companion chats are encrypted at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it in production: old messages can only be read with the same key.
CHAT_ENCRYPTION_KEY=""

# Voyage AI embeddings (https://dashboard.voyageai.com). Optional: meaning-based verse search for the companion.
# After setting it, run `npm run bible:embed` once. Without it, search uses keywords + the topic map.
VOYAGE_API_KEY=""

# Model overrides (defaults: claude-sonnet-5-5 for answers, claude-haiku-5-5 for the safety check)
# AI_MODEL_MAIN=""
# AI_MODEL_FAST=""
